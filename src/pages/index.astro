---
import CategoryNav from "../components/CategoryNav.astro";
import Logo from "../components/Logo.astro";
import MenuItem from "../components/MenuItem.astro";
import menu from "../data/menu.json";
import Layout from "../layouts/Layout.astro";

const { restaurant, categories } = menu;
---

<Layout title={`Cardápio — ${restaurant.name}`}>
  <header class="px-5 pt-10 pb-6 text-center flex flex-col items-center">
    <Logo size={112} />
    <h1 class="mt-4 font-display text-2xl text-parchment">{restaurant.name}</h1>
    <p class="mt-1 text-sm text-sage">{restaurant.tagline}</p>

    <ul class="mt-4 space-y-1 text-sm text-sage">
      <li>📍 {restaurant.address}</li>
      <li>🛵 {restaurant.delivery}</li>
      <li>📞 {restaurant.phone}</li>
    </ul>
  </header>

  <CategoryNav categories={categories} />

  <main class="px-5 max-w-2xl mx-auto">
    {
      categories.map((category) => (
        <section id={category.id} class="pt-8 pb-2 scroll-mt-16">
          <h2 class="font-display text-xl text-amber mb-1">{category.name}</h2>
          <ul class="divide-y divide-parchment/10">
            {category.items.map((item) => (
              <MenuItem
                name={item.name}
                description={item.description}
                price={item.price}
              />
            ))}
          </ul>
        </section>
      ))
    }
  </main>

  <footer class="px-5 pt-10 pb-24 text-center text-xs text-sage/70">
    Cardápio sujeito a alterações sem aviso prévio.
  </footer>

  <a
    href={restaurant.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Pedir pelo WhatsApp"
    class="fixed bottom-5 right-5 flex items-center gap-2 bg-amber text-inkdeep font-body font-semibold text-sm px-4 py-3 rounded-full shadow-lg shadow-black/40 hover:brightness-110 transition"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.7.44 3.36 1.29 4.82L2 22l5.4-1.41a9.9 9.9 0 0 0 4.64 1.18h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.13-2.9-7-1.87-1.87-4.35-2.86-6.01-2.86Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.55-3.7 8.21-8.25 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.24-.65.81-.79.98-.15.16-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.73-.66-1.23-1.46-1.37-1.71-.15-.24-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.48-.01a.9.9 0 0 0-.66.31c-.23.24-.86.85-.86 2.07s.89 2.4 1.01 2.57c.13.16 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.19.2-.58.2-1.08.14-1.19-.06-.1-.23-.16-.48-.28Z"
      ></path>
    </svg>
    Pedir agora
  </a>
</Layout>
